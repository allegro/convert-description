{
  "name": "@allegro/convert-description",
  "description": "A JavaScript library to convert HTML-rich offer & product descriptions into a format accepted by Allegro Rest API.",
  "main": "dist/umd.js",
  "bin": {
    "convert-description": "bin/index.js"
  },
  "scripts": {
    "build": "webpack --mode production",
    "clean": "rm -rf dist && rm -rf site/static",
    "dev": "webpack --mode development",
    "test": "mocha",
    "lint": "eslint",
    "lint:fix": "npm run lint -- --fix",
    "start": "webpack serve --config webpack.config.js --progress --color --mode development",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/allegro/convert-description.git"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@babel/core": "7.24.9",
    "@babel/preset-env": "7.24.8",
    "@babel/register": "7.24.6",
    "@eslint/js": "9.31.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/redux-actions": "2.6.5",
    "ace-builds": "1.43.1",
    "autoprefixer": "10.4.20",
    "babel-loader": "9.1.3",
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.13.1",
    "chai": "4.4.1",
    "chai-as-promised": "7.1.2",
    "css-loader": "7.1.2",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-markdown": "5.1.0",
    "eslint-plugin-prettier": "5.5.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "file-loader": "6.2.0",
    "globals": "15.8.0",
    "html-webpack-plugin": "5.6.3",
    "husky": "9.1.1",
    "jsdom": "26.1.0",
    "jsdom-global": "3.0.2",
    "lint-staged": "15.2.7",
    "markdownlint": "0.34.0",
    "markdownlint-cli": "0.41.0",
    "mini-css-extract-plugin": "2.9.2",
    "mocha": "10.6.0",
    "mocha-testdata": "1.2.0",
    "postcss-loader": "8.1.1",
    "pretty": "2.0.0",
    "react": "19.0.0",
    "react-ace": "14.0.1",
    "react-bootstrap": "2.10.7",
    "react-dom": "19.0.0",
    "redux-actions": "3.0.3",
    "sanitize-html": "2.17.0",
    "sass": "1.83.0",
    "sass-loader": "16.0.4",
    "sinon": "18.0.0",
    "sinon-chai": "3.7.0",
    "ts-loader": "9.5.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.37.0",
    "webpack": "5.94.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.1"
  },
  "files": [
    "dist/"
  ],
  "lint-staged": {
    "*.{js,md}": "eslint --cache --fix",
    "*.md": "markdownlint --fix"
  },
  "dependencies": {
    "deepmerge": "4.3.1",
    "isomorphic-dompurify": "2.26.0"
  }
}
